# Copiá este archivo como .env y completá los valores.
PORT=8080
# Contraseña para entrar a /panel
ADMIN_PASSWORD=

# Correo Argentino (MiCorreo) — librería ylazzari-correoargentino.
# Sin estos datos, el envío se calcula con la tabla de js/envios.json.
# Las credenciales se piden a Correo (formulario: https://www.correoargentino.com.ar/MiCorreo/public/contact)
# y son distintas para TEST y PROD.
CORREO_AMBIENTE=TEST
CORREO_USER_TOKEN=
CORREO_PASSWORD_TOKEN=
# Completá CORREO_CUSTOMER_ID si lo tenés; si no, CORREO_EMAIL y CORREO_PASSWORD (de tu cuenta MiCorreo).
CORREO_CUSTOMER_ID=
CORREO_EMAIL=
CORREO_PASSWORD=
